    </dependencies>

    <profiles>
        <profile>
            <!--
                Note: this is in a profile so that certain IDEs (e.g., NetBeans)
                will not use this profile when running the app from the IDE.
                This allows the IDE to choose the correct JRE to run the app,
                whereas this requires that the "java" command point to the
                correct version.
            -->
            <!-- mvn exec:exec -Papp to run the main app -->
            <id>app</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-Xmx4g</argument>
                                <argument>-Xms1g</argument>
                                <argument>-Xss1m</argument>
                                <!--
                                    Java 17+ enforces strong module encapsulation by default;
                                    a few helpers still reach into javax.swing.table internals.
                                    FlatLaf also loads a native library for window decorations
                                    and DPI, which Java 22+ gates behind native-access opt-in.
                                    Mirror both flags into the jpackage java-options when packaging.
                                -->
                                <argument>--add-opens=java.desktop/javax.swing.table=ALL-UNNAMED</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-javaagent:lib/local/jar-loader/1.0/jar-loader-1.0.jar</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>ca.cgjennings.apps.arkham.StrangeEons</argument>
                                <argument>--xDisableJreCheck</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- mvn exec:exec -Pdebugger to start the script debug client -->
            <id>debugger</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>ca.cgjennings.apps.arkham.plugins.debugging.Client</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- mvn exec:exec -Picon-designer to start the little glyph icon design tool -->
            <id>icon-designer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>ca.cgjennings.ui.theme.ThemedGlyphIconDesigner</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
                mvn package -Pdeploy assembles a single shaded jar at
                deployment/assembled/strange-eons.jar containing all dependencies.
                The jpackage-{linux,mac,win} profiles consume that jar to build
                native installers, so a full build is:

                    mvn package -Pdeploy,jpackage-linux   (on Linux)
                    mvn package -Pdeploy,jpackage-mac     (on macOS)
                    mvn package -Pdeploy,jpackage-win     (on Windows)
             -->
            <id>deploy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.2</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>ca.cgjennings.apps.arkham.StrangeEons</mainClass>
                                            <manifestEntries>
                                                <PreMain-Class>ca.cgjennings.jvm.JarLoader</PreMain-Class>
                                                <Agent-Class>ca.cgjennings.jvm.JarLoader</Agent-Class>
                                            </manifestEntries>
                                        </transformer>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <!-- exclude some files that are superfluous or whose content is duplicated -->
                                            <excludes>
                                                <exclude>**/license-metadata/**</exclude>
                                                <exclude>**/META-INF/LICENSE</exclude>
                                                <exclude>**/META-INF/LICENSE.txt</exclude>
                                                <exclude>**/META-INF/maven/**</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <finalName>strange-eons</finalName>
                                    <outputDirectory>${project.basedir}/deployment/assembled</outputDirectory>
                                    <shadedArtifactAttached>false</shadedArtifactAttached>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!--
                            

                            Two executions, both bound to phase "package" and
                            within the same plugin so Maven runs them in the
                            order declared below (single-profile = no
                            cross-profile ordering ambiguity):
                              1) remove-unshaded-original — maven-shade-plugin 
                                 renames the pre-shade jar to original-strange-eons.jar 
                                 in the same output dir. If left, jpackage's 
                                 input scan picks it up and bundles both jars 
                                 in the installer. Delete it once shade has
                                 run so only the shaded jar reaches jpackage.
                              2) sign-jar-natives — signs Mach-O dylibs
                                 embedded inside strange-eons.jar (FlatLaF
                                 natives) so Apple notarization stops
                                 rejecting them. The script no-ops on non-Mac
                                 hosts and when the signing identity property
                                 is empty, so this execution is safe to run
                                 unconditionally on every platform.
                        -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>remove-unshaded-original</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete>
                                            <fileset dir="${project.basedir}/deployment/assembled" includes="original-*.jar" erroronmissingdir="false"/>
                                        </delete>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>sign-jar-natives</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <exec executable="${project.basedir}/deployment/scripts/sign-jar-natives.sh"
                                              failonerror="true" osfamily="unix">
                                            <arg value="${project.basedir}/deployment/assembled/strange-eons.jar"/>
                                            <arg value="${strange-eons.apple.signing.identity}"/>
                                            <arg value="${project.basedir}/deployment/entitlements.plist"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            jpackage profiles produce native installers. One profile per OS so
            that CI can activate exactly one per matrix runner. Each depends on
            the shaded jar from the deploy profile, so use:
                mvn package -Pdeploy,jpackage-linux   (on Linux)
                mvn package -Pdeploy,jpackage-mac     (on macOS)
                mvn package -Pdeploy,jpackage-win     (on Windows)
            app.version may be overridden from the command line; default is
            wired to a placeholder until the git-tag-driven version source lands.
        -->
        <profile>
            <id>jpackage-linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.4</version>
                        <configuration>
                            <name>Strange Eons</name>
                            <appVersion>${app.version}</appVersion>
                            <vendor>${app.vendor}</vendor>
                            <copyright>${app.copyright}</copyright>
                            <input>${project.basedir}/deployment/assembled</input>
                            <destination>${project.basedir}/deployment/installers</destination>
                            <mainJar>strange-eons.jar</mainJar>
                            <mainClass>ca.cgjennings.apps.arkham.StrangeEons</mainClass>
                            <icon>${project.basedir}/deployment/assets/icons/app/48.png</icon>
                            <runtimeImage>${java.home}</runtimeImage>
                            <javaOptions>
                                <option>-javaagent:$APPDIR/strange-eons.jar</option>
                                <option>--add-opens=java.desktop/javax.swing.table=ALL-UNNAMED</option>
                                <option>--enable-native-access=ALL-UNNAMED</option>
                                <option>-Xmx4g</option>
                                <option>-Xms1g</option>
                                <option>-Xss1m</option>
                            </javaOptions>
                        </configuration>
                        <!--
                            Linux packaging options (linuxPackageName, linuxAppCategory,
                            linuxMenuGroup, linuxShortcut) are valid only for type
                            deb/rpm. If put in the shared configuration the app-image
                            execution fails with "Option linux-package-name is not
                            valid with type app-image". Keep them per-execution.
                        -->
                        <executions>
                            <execution>
                                <id>jpackage-deb</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>DEB</type>
                                    <linuxPackageName>strange-eons</linuxPackageName>
                                    <linuxAppCategory>Graphics</linuxAppCategory>
                                    <linuxMenuGroup>Graphics</linuxMenuGroup>
                                    <linuxShortcut>true</linuxShortcut>
                                    <!-- Scoped per-execution: jpackage rejects file
                                         associations for type=app-image. Icon paths in
                                         each .properties file are resolved relative to
                                         the Maven working directory (project root). -->

                                    <fileAssociations>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/eon.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/seplugin.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/seext.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/setheme.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/selibrary.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/seproject.properties</fileAssociation>
                                    </fileAssociations>
                                    <launchers>
                                        <launcher>
                                            <name>sedebug</name>
                                            <file>${project.basedir}/deployment/jpackage/launchers/linux/debugger.properties</file>
                                        </launcher>
                                    </launchers>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-rpm</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>RPM</type>
                                    <linuxPackageName>strange-eons</linuxPackageName>
                                    <linuxAppCategory>Graphics</linuxAppCategory>
                                    <linuxMenuGroup>Graphics</linuxMenuGroup>
                                    <linuxShortcut>true</linuxShortcut>
                                    <fileAssociations>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/eon.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/seplugin.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/seext.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/setheme.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/selibrary.properties</fileAssociation>
                                        <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/linux/seproject.properties</fileAssociation>
                                    </fileAssociations>
                                    <launchers>
                                        <launcher>
                                            <name>sedebug</name>
                                            <file>${project.basedir}/deployment/jpackage/launchers/linux/debugger.properties</file>
                                        </launcher>
                                    </launchers>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>jpackage-mac</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.4</version>
                        <configuration>
                            <name>Strange Eons</name>
                            <appVersion>${app.version}</appVersion>
                            <vendor>${app.vendor}</vendor>
                            <copyright>${app.copyright}</copyright>
                            <input>${project.basedir}/deployment/assembled</input>
                            <destination>${project.basedir}/deployment/installers</destination>
                            <mainJar>strange-eons.jar</mainJar>
                            <mainClass>ca.cgjennings.apps.arkham.StrangeEons</mainClass>
                            <icon>${project.basedir}/deployment/assets/icons/app/application.icns</icon>
                            <runtimeImage>${java.home}</runtimeImage>
                            <javaOptions>
                                <option>-javaagent:$APPDIR/strange-eons.jar</option>
                                <option>--add-opens=java.desktop/javax.swing.table=ALL-UNNAMED</option>
                                <option>--enable-native-access=ALL-UNNAMED</option>
                                <option>-Xmx4g</option>
                                <option>-Xms1g</option>
                                <option>-Xss1m</option>
                            </javaOptions>
                            <macPackageName>Strange Eons</macPackageName>
                            <!-- Bundle identifier shipped at v3.5.0; do not
                                 change. Pre-3.5 install4j builds used the
                                 auto-derived com.install4j.0581-5195-2362-0248.29,
                                 so the upgrade from install4j is already a
                                 fresh install for those users. Changing this
                                 value now would break upgrades from 3.5.0
                                 onward. macPackageSigningPrefix below must
                                 mirror this identifier with a trailing dot. -->
                            <macPackageIdentifier>ca.cgjennings.strange-eons</macPackageIdentifier>
                            <fileAssociations>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/mac/eon.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/mac/seplugin.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/mac/seext.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/mac/setheme.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/mac/selibrary.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/mac/seproject.properties</fileAssociation>
                            </fileAssociations>
                            <!-- macOS bundles allow only one Launchpad/Dock
                                 entry per .app, so sedebug ships as a secondary
                                 binary in Contents/MacOS/ and must be invoked
                                 directly (no menu entry). -->
                            <launchers>
                                <launcher>
                                    <name>sedebug</name>
                                    <file>${project.basedir}/deployment/jpackage/launchers/mac/debugger.properties</file>
                                </launcher>
                            </launchers>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jpackage-dmg</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>DMG</type>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Layered profile: when -Dstrange-eons.apple.signing.identity=<fragment>
            is passed, this profile auto-activates and merges signing options
            into the jpackage-mac plugin configuration above. With no property
            set, the jpackage-mac profile alone produces an unsigned .dmg as
            before. Property name is namespaced to avoid colliding with anything
            a user might define in ~/.m2/settings.xml.

            The fragment passed here is just the "team or user name portion"
            (e.g. "Jane Doe"); jpackage prepends "Developer ID Application: "
            internally before searching the keychain. The CI side strips the
            full identity stored in the APPLE_SIGNING_IDENTITY secret down to
            this fragment in .github/workflows/release.yml ("Build native
            installers" step) before passing it on the command line.
        -->
        <profile>
            <id>jpackage-mac-sign</id>
            <activation>
                <property>
                    <name>strange-eons.apple.signing.identity</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.4</version>
                        <configuration>
                            <macSign>true</macSign>
                            <macSigningKeyUserName>${strange-eons.apple.signing.identity}</macSigningKeyUserName>
                            <macEntitlements>${project.basedir}/deployment/entitlements.plist</macEntitlements>
                            <macPackageSigningPrefix>ca.cgjennings.strange-eons.</macPackageSigningPrefix>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>jpackage-win</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.7.4</version>
                        <configuration>
                            <name>Strange Eons</name>
                            <appVersion>${app.version}</appVersion>
                            <vendor>${app.vendor}</vendor>
                            <copyright>${app.copyright}</copyright>
                            <input>${project.basedir}/deployment/assembled</input>
                            <destination>${project.basedir}/deployment/installers</destination>
                            <mainJar>strange-eons.jar</mainJar>
                            <mainClass>ca.cgjennings.apps.arkham.StrangeEons</mainClass>
                            <icon>${project.basedir}/deployment/assets/icons/app/application.ico</icon>
                            <runtimeImage>${java.home}</runtimeImage>
                            <javaOptions>
                                <option>-javaagent:$APPDIR/strange-eons.jar</option>
                                <option>--add-opens=java.desktop/javax.swing.table=ALL-UNNAMED</option>
                                <option>--enable-native-access=ALL-UNNAMED</option>
                                <option>-Xmx4g</option>
                                <option>-Xms1g</option>
                                <option>-Xss1m</option>
                            </javaOptions>
                            <winShortcut>true</winShortcut>
                            <winMenu>true</winMenu>
                            <winMenuGroup>Strange Eons</winMenuGroup>
                            <winDirChooser>true</winDirChooser>
                            <!-- MSI upgrade GUID shipped at v3.5.0; do not
                                 change. Install4j MSIs used a different GUID
                                 so install4j installs do not upgrade in place
                                 to 3.5.x. Changing this value now would also
                                 break the 3.5.0 -> 3.5.x upgrade path. -->
                            <winUpgradeUuid>9f5b1c30-0d2e-4f7a-8e1b-3a4d6b8e9c10</winUpgradeUuid>
                            <fileAssociations>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/win/eon.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/win/seplugin.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/win/seext.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/win/setheme.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/win/selibrary.properties</fileAssociation>
                                <fileAssociation>${project.basedir}/deployment/jpackage/file-associations/win/seproject.properties</fileAssociation>
                            </fileAssociations>
                            <launchers>
                                <launcher>
                                    <name>sedebug</name>
                                    <file>${project.basedir}/deployment/jpackage/launchers/win/debugger.properties</file>
                                </launcher>
                                <launcher>
                                    <name>eons</name>
                                    <file>${project.basedir}/deployment/jpackage/launchers/win/eons-console.properties</file>
                                </launcher>
                            </launchers>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jpackage-msi</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>MSI</type>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <!--
                    Exposes each dependency's resolved file path as a Maven
                    property (e.g. ${org.mockito:mockito-core:jar}) so
                    surefire can preload Mockito's own jar as a JVM agent
                    via -javaagent. Loading the agent statically avoids the
                    JVM warning about dynamic agent attachment, which JEP 451
                    will eventually disallow by default.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>resolve-test-deps</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- -Xshare:off explicitly disables CDS so the JVM doesn't
                         warn that the agent's append to the bootstrap classpath
                         has voided sharing. -->
                    <argLine>-Xshare:off -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>Strange Eons requires Java 25 or later to build.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!--
                        Filter the rev template into the compiled-classes output
                        so StrangeEons.<clinit> finds it via getResourceAsStream.
                        Defaults below produce a DEVELOPMENT/99999 build for
                        local checkouts. Release workflows override the app.*
                        properties from the matching git tag.
                    -->
                    <execution>
                        <id>generate-rev-file</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/ca/cgjennings/apps/arkham</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/build/templates</directory>
                                    <includes>
                                        <include>rev</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>ca.cgjennings.apps.arkham.StrangeEons</exec.mainClass>
        <!--
            app.* properties are the source of truth for application version
            metadata. Defaults match StrangeEons.INTERNAL_BUILD_NUMBER and the
            dev fallback in the rev parser. Release builds override these from
            the git tag (e.g., v3.5.0-alpha -> major=3 minor=5 patch=0
            build=<workflow-derived> type=ALPHA).
        -->
        <app.major>3</app.major>
        <app.minor>5</app.minor>
        <app.patch>0</app.patch>
        <app.build>99999</app.build>
        <app.type>DEVELOPMENT</app.type>
        <app.version>${app.major}.${app.minor}.${app.patch}</app.version>
        <app.vendor>Christopher Currie</app.vendor>
        <app.copyright>Copyright Christopher Jennings and contributors</app.copyright>
    </properties>
</project>
